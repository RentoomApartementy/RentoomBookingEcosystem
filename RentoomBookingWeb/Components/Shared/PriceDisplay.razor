@using RentoomBooking.SharedFrontend.Currency
@using Microsoft.Extensions.Localization
@inject ICurrentUiCurrencyProvider CurrencyProvider
@inject IStringLocalizer<RentoomBookingWeb.Currency> CurrencyLocalizer

<span class="price-display @CssClass">
    <span class="price-primary">@AmountPln?.ToString("N2") @CurrencyLocalizer["PLN"]</span>
    @if (_secondaryText is not null)
    {
        <span class="price-secondary">@_secondaryText</span>
    }
</span>

@code {
    [Parameter] public decimal? AmountPln { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private string? _secondaryText;

    protected override async Task OnParametersSetAsync()
    {
        _secondaryText = null;
        if (AmountPln is null)
        {
            return;
        }

        if (CurrencyProvider.CurrencyCode is null)
        {
            return;
        }

        var rate = await CurrencyProvider.GetRateAsync();
        if (rate is null)
        {
            return;
        }

        // rate.Rate to notowanie NBP: liczba PLN za 1 jednostkę waluty obcej (np. 1 USD = 3.80 PLN) - dzielimy, nie mnożymy.
        var converted = AmountPln.Value / rate.Rate;
        var symbol = rate.CurrencyCode switch
        {
            "EUR" => "€",
            "USD" => "$",
            "GBP" => "£",
            _ => rate.CurrencyCode
        };
        _secondaryText = $"≈ {converted.ToString("N2")} {symbol}";
    }
}
