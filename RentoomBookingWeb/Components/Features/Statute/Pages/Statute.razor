@using RentoomBooking.SharedClasses.Models
@using RentoomBooking.SharedClasses.Services.ReservationWorkflow
@using RentoomBookingWeb.Components.Features.Statute.Components
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject CustomerTermsService TermsService
@inject NavigationManager NavManager
@inject IStringLocalizer<RentoomBookingWeb.StatutePage> Localizer
@inject RentoomBookingWeb.Services.Localization.IRouteLocalizationService RouteService

<PageTitle>@PageTitleText</PageTitle>

<HeadContent>
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta name="description" content="@SeoDescription" />
    @if (SeoKeywords is not null)
    {
        <meta name="keywords" content="@SeoKeywords" />
    }

    <meta property="og:title" content="@CurrentBreadcrumbName" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:image" content="@($"{NavManager.BaseUri}assets/images/header-bg-statute.jpg")" />

    <BreadcrumbJsonLd CurrentPageName="@CurrentBreadcrumbName" CurrentPagePath="@CurrentBreadcrumbPath" />
    <SeoHreflangs />
</HeadContent>

<main class="statute-container">
    <HeaderSection ImagePath="/assets/images/header-bg-statute.jpg" Title="@HeroTitle" Height="230px" />
    
    <div class="main-wrapper">
        @if (_isLoading)
        {
            <div class="loading-container">@Localizer["LoadingStatutes"]</div>
        }
        else if (_currentTerm != null)
        {
            <div class="statute-content">
                @if (!IsDetailPage)
                {
                    @* Na stronie szczegółowej tytuł regulaminu jest już nagłówkiem H1, więc go tu nie powtarzamy. *@
                    <h2>@(_currentTerm.Title ?? _currentTerm.Description)</h2>
                }
                <RegulationViewer Content="@_currentTerm.HtmlContent" />
            </div>

            <hr />

            <RegulationsList Regulations="@_allTerms" />
        }
        else
        {
            <div class="error-container">@Localizer["StatuteNotFound"]</div>
        }
    </div>
</main>

@implements IDisposable

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private List<CustomerTermDisplayDto> _allTerms = new();
    private CustomerTermDisplayDto? _currentTerm;
    private bool _isLoading = true;
    private CancellationTokenSource _cts = new();

    // Bez Id strona jest listą regulaminów — _currentTerm jest wtedy tylko domyślnie
    // załadowanym regulaminem "Main", więc o stronie szczegółowej decyduje Id, nie _currentTerm.
    private bool IsDetailPage => Id.HasValue && _currentTerm is not null;
    private string? TermTitle => _currentTerm?.Title ?? _currentTerm?.Description;

    // Zwraca null zamiast pustej wartości/nazwy klucza, gdy tłumaczenie jeszcze nie istnieje
    // w danym języku (nowe klucze trafiają do pozostałych kultur dopiero po uruchomieniu
    // RentoomBooking.ResxTranslator). Dzięki temu strona nie renderuje pustych metadanych.
    private string? LocalizedOrNull(string key)
    {
        var value = Localizer[key];
        return value.ResourceNotFound || string.IsNullOrWhiteSpace(value.Value) ? null : value.Value;
    }

    private string HeroTitle => IsDetailPage && !string.IsNullOrWhiteSpace(TermTitle)
        ? TermTitle!
        : Localizer["StatuteHeader"];

    private string PageTitleText
    {
        get
        {
            if (!IsDetailPage || string.IsNullOrWhiteSpace(TermTitle))
            {
                return Localizer["PageTitle"];
            }

            var format = LocalizedOrNull("PageTitleFormat");
            // Brak przetłumaczonego formatu — zostajemy przy ogólnym tytule strony.
            return format is not null ? string.Format(format, TermTitle) : Localizer["PageTitle"];
        }
    }

    private string CurrentBreadcrumbName => IsDetailPage && !string.IsNullOrWhiteSpace(TermTitle)
        ? TermTitle!
        : Localizer["StatuteHeader"];
    private string CurrentBreadcrumbPath => Id.HasValue
        ? $"{RouteService.GetLocalizedUrl("Statute")}/{Id}{(string.IsNullOrWhiteSpace(Slug) ? string.Empty : $"/{Slug}")}"
        : RouteService.GetLocalizedUrl("Statute");

    private string CanonicalUrl => $"{NavManager.BaseUri.TrimEnd('/')}{CurrentBreadcrumbPath}";

    private string SeoDescription
    {
        get
        {
            if (IsDetailPage)
            {
                if (!string.IsNullOrWhiteSpace(_currentTerm?.Description)) return _currentTerm.Description;
                if (!string.IsNullOrWhiteSpace(_currentTerm?.Title)) return _currentTerm.Title;
            }

            return LocalizedOrNull("MetaDescription")
                ?? (!string.IsNullOrWhiteSpace(_currentTerm?.Description) ? _currentTerm.Description : null)
                ?? Localizer["StatuteHeader"].Value;
        }
    }

    private string? SeoKeywords => LocalizedOrNull("MetaKeywords");


    protected override async Task OnParametersSetAsync()
    {
        // Cancel any pending operation before starting a new one
        await _cts.CancelAsync();
        _cts.Dispose();
        _cts = new CancellationTokenSource();

        try
        {
            await LoadDataAsync(_cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Expected when parameters change quickly
        }
    }

    private async Task LoadDataAsync(CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var culture = CultureInfo.CurrentUICulture.Name;
            _allTerms = await TermsService.GetTermsForDisplayAsync(culture, ct: ct);

            if (Id.HasValue)
            {
                _currentTerm = await TermsService.GetTermByIdAsync(Id.Value, culture, ct: ct);
            }
            else
            {
                // Domyślnie ładujemy pierwszy regulamin typu "Main"
                _currentTerm = _allTerms.FirstOrDefault(t => t.TermsType == "Main") 
                              ?? _allTerms.FirstOrDefault();
            }
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
