@using RentoomBookingWeb.Components.Features.Blog.Components;
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

<PageTitle>@(CategoryDisplayName ?? Localizer["BlogPageTitle"])</PageTitle>

<HeadContent>
    @if (Environment.IsProduction())
    {
        <meta name="robots" content="@(CategoryNotFound ? "noindex, nofollow" : "index, follow")" />
    }
    <meta name="description" content="@Localizer["BlogDescription"]" />
    <link rel="canonical" href="@($"{NavManager.BaseUri.TrimEnd('/')}{BuildCategoryListUrl(Category)}")" />
    <BlogJsonLd Name="@Localizer["BlogDescription"]"
                Description="@Localizer["BlogHeaderSubtitle"]"
                Url="@BuildCategoryListUrl(Category)" />
    @if (!string.IsNullOrWhiteSpace(Category) && !string.IsNullOrWhiteSpace(CategoryDisplayName))
    {
        <BreadcrumbJsonLd CurrentPageName="@CategoryDisplayName"
                          CurrentPagePath="@BuildCategoryListUrl(Category)"
                          ParentPageName="Blog"
                          ParentPagePath="@RouteService.GetLocalizedUrl("BlogList")"
                          FirstPageName="Rentoom" />
    }
    else
    {
        <BreadcrumbJsonLd CurrentPageName="Blog" CurrentPagePath="@RouteService.GetLocalizedUrl("BlogList")" FirstPageName="Rentoom" />
    }
    <SeoHreflangs />
</HeadContent>

@if (Items.Count > 0)
{
    <BlogHeaderSection Items="Items" UseH1ForTitle="true" />
}

<div class="blog-list-breadcrumb">
    @if (!string.IsNullOrWhiteSpace(Category) && !string.IsNullOrWhiteSpace(CategoryDisplayName))
    {
        <BlogBreadcrumb NavigationLabel="@Localizer["BreadcrumbNavigationLabel"]"
                        HomeUrl="@RouteService.GetLocalizedUrl("Home")"
                        HomeLabel="Rentoom"
                        ParentPageName="Blog"
                        ParentPageUrl="@RouteService.GetLocalizedUrl("BlogList")"
                        CurrentPageName="@CategoryDisplayName" />
    }
    else
    {
        <BlogBreadcrumb NavigationLabel="@Localizer["BreadcrumbNavigationLabel"]"
                        HomeUrl="@RouteService.GetLocalizedUrl("Home")"
                        HomeLabel="Rentoom"
                        CurrentPageName="Blog" />
    }
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <BlogErrorSection ErrorMessage="@Error" IsNotFound="false" />
}
else if (IsLoading && Items.Count == 0)
{
    <BlogListSkeleton />
}
else if (CategoryNotFound)
{
    <BlogErrorSection IsNotFound="true" />
}
else
{
    <div class="blog-list-container">
        <h2 class="blog-list-title">@(CategoryDisplayName ?? Localizer["LatestPosts"])</h2>

        @if (Items.Any())
        {
            <div class="blog-posts-grid">
                @{
                    int index = 0;
                }
                @foreach (var item in Items)
                {
                    if (index == 0)
                    {
                        <BlogFeaturedItem Item="item" />
                    }
                    else
                    {
                        <BlogItem Item="item" />
                    }
                    index++;
                }
            </div>
        }
        else
        {
            <BlogEmptySection />
        }
    </div>
}

<div id="scroll-anchor" style="height: 10px; width: 100%;"></div>
