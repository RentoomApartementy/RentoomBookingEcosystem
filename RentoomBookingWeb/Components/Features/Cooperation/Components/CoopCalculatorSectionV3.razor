@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<section class="coop-v3-calculator" id="coop-calculator">
    <div class="coop-v3-calculator-intro">
        <span class="coop-v3-calculator-eyebrow">@L["Coop_Calc_Eyebrow"]</span>
        <h2>@L["Coop_Calc_Title"]</h2>
        <p>@L["Coop_Calc_Subtitle"]</p>
    </div>

    <CoopSimpleCalculatorV3 />

    <div class="coop-v3-detailed-toggle">
        <button class="coop-v3-toggle-btn" @onclick="() => _showDetailed = !_showDetailed">
            <span class="gicon">@(_showDetailed ? "expand_less" : "expand_more")</span>
            @(_showDetailed ? L["Coop_Calc_HideDetailed"] : L["Coop_Calc_ShowDetailed"])
        </button>
    </div>
</section>

@code {
    private bool _showDetailed;
}
