@using Microsoft.Extensions.Localization
@using RentoomBookingWeb.Services.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L
@inject IRouteLocalizationService RouteService

<section class="coop-hero">
    <div class="coop-hero-overlay"></div>
    <div class="coop-hero-content">
        <span class="coop-eyebrow">@L["Coop_Hero_Eyebrow"]</span>
        <h1 class="coop-hero-title">@L["Coop_Hero_Title"]</h1>
        <p class="coop-hero-subtitle">@L["Coop_Hero_Subtitle"]</p>
        <div class="coop-hero-actions">
            <Button Type="ButtonType.Primary" OnClick="OpenFormModal">@L["Coop_Hero_Cta"]</Button>
            <a href="@CalcHref" class="coop-hero-link">
                <span class="gicon">calculate</span>
                @L["Coop_Hero_CalcLink"]
            </a>
        </div>
    </div>
    <div class="coop-hero-stats">
        <div class="coop-stat">
            <strong>@L["Coop_Hero_Stat1_Value"]</strong>
            <span>@L["Coop_Hero_Stat1_Label"]</span>
        </div>
        <div class="coop-stat">
            <strong>@L["Coop_Hero_Stat2_Value"]</strong>
            <span>@L["Coop_Hero_Stat2_Label"]</span>
        </div>
        <div class="coop-stat">
            <strong>@L["Coop_Hero_Stat3_Value"]</strong>
            <span>@L["Coop_Hero_Stat3_Label"]</span>
        </div>
        <div class="coop-stat">
            <strong>@L["Coop_Hero_Stat4_Value"]</strong>
            <span>@L["Coop_Hero_Stat4_Label"]</span>
        </div>
    </div>
</section>

@code {
    [CascadingParameter] public EventCallback OpenFormModal { get; set; }

    private string CalcHref => $"{RouteService.GetLocalizedUrl("Cooperation")}#coop-calculator";
}
