@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<section class="coop-v3-owner" aria-labelledby="coop-v3-owner-title">
    <div class="coop-v3-owner-copy">
        <span>@L["Coop_V3_Owner_Eyebrow"]</span>
        <h2 id="coop-v3-owner-title">@L["Coop_V3_Owner_Title"]</h2>
        <p>@L["Coop_V3_Owner_Intro"]</p>
        <CoopSectionCta />
    </div>

    <div class="coop-v3-owner-benefits">
        <article><span class="gicon" aria-hidden="true">space_dashboard</span><h3>@L["Coop_V3_Owner_Panel"]</h3></article>
        <article><span class="gicon" aria-hidden="true">finance</span><h3>@L["Coop_V3_Owner_Reports"]</h3></article>
        <article><span class="gicon" aria-hidden="true">gavel</span><h3>@L["Coop_V3_Owner_Legal"]</h3></article>
        <article><span class="gicon" aria-hidden="true">support_agent</span><h3>@L["Coop_V3_Owner_Care"]</h3></article>
    </div>
</section>
