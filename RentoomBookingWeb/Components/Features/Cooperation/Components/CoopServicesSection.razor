@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<section class="coop-services">
    <span class="coop-eyebrow">@L["Coop_Services_Eyebrow"]</span>
    <h2 class="coop-section-title">@L["Coop_Services_Title"]</h2>

    <div class="coop-services-grid">
        <div class="coop-service-item">
            <span class="gicon coop-service-icon">photo_camera</span>
            <div>
                <h3>@L["Coop_Service1_Title"]</h3>
                <p>@L["Coop_Service1_Desc"]</p>
            </div>
        </div>
        <div class="coop-service-item">
            <span class="gicon coop-service-icon">language</span>
            <div>
                <h3>@L["Coop_Service2_Title"]</h3>
                <p>@L["Coop_Service2_Desc"]</p>
            </div>
        </div>
        <div class="coop-service-item">
            <span class="gicon coop-service-icon">trending_up</span>
            <div>
                <h3>@L["Coop_Service3_Title"]</h3>
                <p>@L["Coop_Service3_Desc"]</p>
            </div>
        </div>
        <div class="coop-service-item">
            <span class="gicon coop-service-icon">chat</span>
            <div>
                <h3>@L["Coop_Service4_Title"]</h3>
                <p>@L["Coop_Service4_Desc"]</p>
            </div>
        </div>
        <div class="coop-service-item">
            <span class="gicon coop-service-icon">dry_cleaning</span>
            <div>
                <h3>@L["Coop_Service5_Title"]</h3>
                <p>@L["Coop_Service5_Desc"]</p>
            </div>
        </div>
        <div class="coop-service-item">
            <span class="gicon coop-service-icon">build</span>
            <div>
                <h3>@L["Coop_Service6_Title"]</h3>
                <p>@L["Coop_Service6_Desc"]</p>
            </div>
        </div>
    </div>

    <CoopSectionCta />
</section>
