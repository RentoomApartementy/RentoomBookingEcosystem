@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<div class="coop-simple-calc">
    <span class="coop-eyebrow-sm">@L["Coop_Calc_Simple_Eyebrow"]</span>

    <div class="coop-calc-field">
        <label>@L["Coop_Calc_Location_Label"]</label>
        <div class="coop-pills">
            @foreach (var loc in _mainLocations)
            {
                var key = loc.Key;
                <button class="coop-pill @(_selectedLocation == key ? "active" : "")"
                        @onclick="() => SelectLocation(key)">
                    @L[$"Coop_Calc_Loc_{key}"]
                </button>
            }
            <button class="coop-pill coop-pill-more @(_showMoreLocations ? "active" : "")"
                    @onclick="() => _showMoreLocations = !_showMoreLocations">
                <span class="gicon coop-pill-icon">@(_showMoreLocations ? "expand_less" : "expand_more")</span>
                @L["Coop_Calc_Loc_More"]
            </button>
        </div>
        @if (_showMoreLocations)
        {
            <div class="coop-pills coop-pills-extra">
                @foreach (var loc in _extraLocations)
                {
                    var key = loc.Key;
                    <button class="coop-pill @(_selectedLocation == key ? "active" : "")"
                            @onclick="() => SelectLocation(key)">
                        @L[$"Coop_Calc_Loc_{key}"]
                    </button>
                }
            </div>
        }
    </div>

    <div class="coop-calc-field">
        <label>@L["Coop_Calc_Rooms_Label"]: <strong>@_rooms</strong></label>
        <input type="range" min="1" max="4" step="1" @bind="_rooms" @bind:event="oninput" class="coop-slider" />
        <div class="coop-slider-labels">
            <span>1</span><span>2</span><span>3</span><span>4</span>
        </div>
    </div>

    <div class="coop-calc-field">
        <label>@L["Coop_Calc_Standard_Label"]</label>
        <div class="coop-pills">
            @foreach (var std in _standards)
            {
                var key = std.Key;
                <button class="coop-pill @(_selectedStandard == key ? "active" : "")"
                        @onclick="() => SelectStandard(key)">
                    @L[$"Coop_Calc_Std_{key}"]
                </button>
            }
        </div>
    </div>

    <div class="coop-calc-result-box">
        <span class="coop-eyebrow-sm">@L["Coop_Calc_Result_Eyebrow"]</span>
        <div class="coop-calc-payout">
            <span class="coop-calc-range">@FormatPln(PayoutLow) – @FormatPln(PayoutHigh) @L["Coop_Calc_Zl"]</span>
            <span class="coop-calc-payout-label">@L["Coop_Calc_Result_Label"]</span>
        </div>

        <div class="coop-calc-details">
            <div class="coop-calc-row">
                <span>@L["Coop_Calc_AvgRate"]</span>
                <strong>@FormatPln(AvgRateLow) – @FormatPln(AvgRateHigh) @L["Coop_Calc_Zl"]</strong>
            </div>
            <div class="coop-calc-row">
                <span>@L["Coop_Calc_Occupancy"]</span>
                <strong>@OccupancyLow – @OccupancyHigh%</strong>
            </div>
            <div class="coop-calc-row">
                <span>@L["Coop_Calc_GrossRevenue"]</span>
                <strong>@FormatPln(GrossLow) – @FormatPln(GrossHigh) @L["Coop_Calc_Zl"]</strong>
            </div>
            <div class="coop-calc-row">
                <span>@L["Coop_Calc_OpCosts"]</span>
                <strong>@FormatPln(OpCostsLow) – @FormatPln(OpCostsHigh) @L["Coop_Calc_Zl"]</strong>
            </div>
            <div class="coop-calc-row">
                <span>@L["Coop_Calc_Commission"]</span>
                <strong>@FormatPln(CommissionLow) – @FormatPln(CommissionHigh) @L["Coop_Calc_Zl"]</strong>
            </div>
        </div>
    </div>

    <p class="coop-calc-note">@L["Coop_Calc_CtaNote"]</p>
    <div class="coop-calc-cta-row">
        <Button Type="ButtonType.Primary" OnClick="OpenFormModal">@L["Coop_Calc_CtaPrimary"]</Button>
    </div>
</div>

@code {
    [CascadingParameter] public EventCallback OpenFormModal { get; set; }

    private int _rooms = 2;
    private string _selectedLocation = "StareMiasto";
    private string _selectedStandard = "Good";
    private bool _showMoreLocations;

    private record LocationData(string Key, decimal BaseRate, int OccLow, int OccHigh, decimal MultiplierLow, decimal MultiplierHigh);
    private record StandardData(string Key, decimal Multiplier);

    private static readonly LocationData[] _mainLocations =
    {
        new("StareMiasto",  350, 68, 85, 1.0m,  1.15m),
        new("Centrum",      320, 62, 80, 0.92m, 1.08m),
        new("Rubinkowo",    240, 52, 68, 0.70m, 0.85m),
        new("Wrzosy",       250, 54, 70, 0.72m, 0.88m),
        new("Stawki",       230, 50, 66, 0.68m, 0.82m),
        new("BydgoskieI",   280, 58, 75, 0.82m, 0.98m),
        new("BydgoskieII",  270, 56, 73, 0.78m, 0.95m),
    };

    private static readonly LocationData[] _extraLocations =
    {
        new("Chelminskie",   290, 60, 76, 0.85m, 1.0m),
        new("JakubskieMokre", 260, 54, 70, 0.75m, 0.90m),
        new("Bielawy",       235, 50, 66, 0.68m, 0.82m),
        new("Skarpa",        245, 52, 68, 0.70m, 0.85m),
        new("Kaszczorek",    220, 48, 64, 0.64m, 0.78m),
        new("Podgorz",       225, 48, 65, 0.65m, 0.80m),
        new("Rudak",         215, 46, 62, 0.62m, 0.76m),
        new("Czerniewice",   210, 45, 60, 0.60m, 0.74m),
    };

    private LocationData CurrentLocation =>
        _mainLocations.Concat(_extraLocations).First(l => l.Key == _selectedLocation);

    private static readonly StandardData[] _standards =
    {
        new("Basic", 0.85m),
        new("Good", 1.0m),
        new("Premium", 1.25m),
    };

    private StandardData CurrentStandard => _standards.First(s => s.Key == _selectedStandard);

    private decimal RoomMultiplier => 0.6m + (_rooms * 0.4m);

    private decimal AvgRateLow => Math.Round(CurrentLocation.BaseRate * CurrentStandard.Multiplier * RoomMultiplier * CurrentLocation.MultiplierLow);
    private decimal AvgRateHigh => Math.Round(CurrentLocation.BaseRate * CurrentStandard.Multiplier * RoomMultiplier * CurrentLocation.MultiplierHigh);

    private int OccupancyLow => CurrentLocation.OccLow;
    private int OccupancyHigh => CurrentLocation.OccHigh;

    private decimal GrossLow => Math.Round(AvgRateLow * 30 * OccupancyLow / 100m);
    private decimal GrossHigh => Math.Round(AvgRateHigh * 30 * OccupancyHigh / 100m);

    private decimal OpCostsLow => Math.Round(GrossLow * 0.12m);
    private decimal OpCostsHigh => Math.Round(GrossHigh * 0.15m);

    private decimal CommissionLow => Math.Round(GrossLow * 0.30m);
    private decimal CommissionHigh => Math.Round(GrossHigh * 0.30m);

    private decimal PayoutLow => Math.Round(GrossLow - OpCostsHigh - CommissionLow);
    private decimal PayoutHigh => Math.Round(GrossHigh - OpCostsLow - CommissionHigh);

    private void SelectLocation(string key)
    {
        _selectedLocation = key;
        if (_extraLocations.Any(l => l.Key == key))
            _showMoreLocations = true;
    }

    private void SelectStandard(string key) => _selectedStandard = key;

    private static string FormatPln(decimal value) =>
        value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("pl-PL"));
}
