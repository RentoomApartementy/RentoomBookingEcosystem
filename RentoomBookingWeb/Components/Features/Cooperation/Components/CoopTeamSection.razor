@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<section class="coop-team">
    <span class="coop-eyebrow">@L["Coop_Team_Eyebrow"]</span>
    <h2 class="coop-section-title">@L["Coop_Team_Title"]</h2>

    <div class="coop-team-grid">
        @for (int i = 0; i < TeamImagePaths.Length; i++)
        {
            var idx = i + 1;
            <div class="coop-team-card">
                <div class="coop-team-avatar">
                    <img src="@TeamImagePaths[i]" alt="@L[$"Coop_Team{idx}_Name"]" />
                </div>
                <h3>@L[$"Coop_Team{idx}_Name"]</h3>
                <span class="coop-team-role">@L[$"Coop_Team{idx}_Role"]</span>
                <p>@L[$"Coop_Team{idx}_Desc"]</p>
            </div>
        }
    </div>

    <CoopSectionCta />
</section>

@code {
    private static readonly string[] TeamImagePaths =
    [
        "/assets/images/team/MalgorzataGardzielewska.png",
        "/assets/images/team/MonikaKwiatkowska.png",
        "/assets/images/team/WeronikaFeliniak.png",
        "/assets/images/team/AndrzejPietkiewicz.png",
        "/assets/images/team/MalgorzataJedrusik.png",
        "/assets/images/team/KrystianKujawa.png",
        "/assets/images/team/BartoszJedrusik.png"
    ];
}
