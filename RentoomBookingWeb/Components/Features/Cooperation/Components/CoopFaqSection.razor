@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<section class="coop-faq">
    <span class="coop-eyebrow">@L["Coop_Faq_Eyebrow"]</span>
    <h2 class="coop-section-title">@L["Coop_Faq_Title"]</h2>

    <div class="coop-faq-list">
        @for (int i = 1; i <= 7; i++)
        {
            var idx = i;
            <div class="coop-faq-item @(_openIndex == idx ? "open" : "")">
                <button class="coop-faq-toggle" @onclick="() => Toggle(idx)">
                    <span>@L[$"Coop_Faq{idx}_Q"]</span>
                    <span class="gicon coop-faq-chevron">expand_more</span>
                </button>
                @if (_openIndex == idx)
                {
                    <div class="coop-faq-answer">
                        <p>@L[$"Coop_Faq{idx}_A"]</p>
                    </div>
                }
            </div>
        }
    </div>

    <CoopSectionCta />
</section>

@code {
    private int? _openIndex;

    private void Toggle(int idx)
    {
        _openIndex = _openIndex == idx ? null : idx;
    }
}
