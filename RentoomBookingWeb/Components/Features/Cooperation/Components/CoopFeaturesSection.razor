@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<section class="coop-features">
    <span class="coop-eyebrow">@L["Coop_Features_Eyebrow"]</span>
    <h2 class="coop-section-title">@L["Coop_Features_Title"]</h2>

    <div class="coop-features-grid">
        <div class="coop-feature-card">
            <span class="gicon coop-feature-icon">key</span>
            <h3>@L["Coop_Feature1_Title"]</h3>
            <p>@L["Coop_Feature1_Desc"]</p>
        </div>
        <div class="coop-feature-card">
            <span class="gicon coop-feature-icon">verified</span>
            <h3>@L["Coop_Feature2_Title"]</h3>
            <p>@L["Coop_Feature2_Desc"]</p>
        </div>
        <div class="coop-feature-card">
            <span class="gicon coop-feature-icon">trending_up</span>
            <h3>@L["Coop_Feature3_Title"]</h3>
            <p>@L["Coop_Feature3_Desc"]</p>
        </div>
        <div class="coop-feature-card">
            <span class="gicon coop-feature-icon">shield</span>
            <h3>@L["Coop_Feature4_Title"]</h3>
            <p>@L["Coop_Feature4_Desc"]</p>
        </div>
    </div>

    <CoopSectionCta />
</section>
