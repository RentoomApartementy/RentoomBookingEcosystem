@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> L

<section class="coop-process">
    <span class="coop-eyebrow">@L["Coop_Process_Eyebrow"]</span>
    <h2 class="coop-section-title">@L["Coop_Process_Title"]</h2>

    <div class="coop-process-grid">
        @for (int i = 1; i <= 6; i++)
        {
            var idx = i;
            <div class="coop-process-step">
                <span class="coop-step-number">@idx</span>
                <h3>@L[$"Coop_Process{idx}_Title"]</h3>
                <p>@L[$"Coop_Process{idx}_Desc"]</p>
            </div>
        }
    </div>

    <CoopSectionCta />
</section>
