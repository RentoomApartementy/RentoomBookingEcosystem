@using RentoomBookingWeb.Components.Features.Cooperation.Components;
@using RentoomBooking.SharedClasses.Services.Descriptions
@using System.Text.Encodings.Web
@using System.Text.Json
@inject NavigationManager NavManager
@using Microsoft.Extensions.Localization;
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> Localizer;
@inject IStringLocalizer<RentoomBookingWeb.HomePage> HomeLocalizer;
@inject RentoomBookingWeb.Services.Localization.IRouteLocalizationService RouteService
@inject RentoomBookingWeb.Services.ISiteBaseProvider SiteBase

@{
    var normalizedVersion = Version?.Trim().ToLowerInvariant();
    var isV3 = string.IsNullOrEmpty(normalizedVersion) || normalizedVersion == "v3";
    var isNotFound = !isV3;
    var pageTitle = Localizer["Cooperation_PageTitle"];
    var metaDesc = Localizer["Cooperation_MetaDescription"];
    var ogTitle = Localizer["Cooperation_OgTitle"];
    var cooperationBasePath = RouteService.GetLocalizedUrl("Cooperation");
    var currentPagePath = cooperationBasePath;
}

@if (isNotFound)
{
    <RentoomBookingWeb.Components.Pages.NotFoundPage />
}
else
{
    <PageTitle>@pageTitle</PageTitle>

    <HeadContent>
        <meta name="robots" content="index, follow" />
        <meta name="description" content="@metaDesc" />
        <meta name="keywords" content="@Localizer["Cooperation_MetaKeywords"]" />
        <link rel="canonical" href="@SiteBase.GetAbsoluteUrl(currentPagePath)" />

        <meta property="og:title" content="@ogTitle" />
        <meta property="og:description" content="@metaDesc" />
        <meta property="og:image" content="@SiteBase.GetAbsoluteUrl("/assets/images/header-bg-coop.jpeg")" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@SiteBase.GetAbsoluteUrl(currentPagePath)" />
        <BreadcrumbJsonLd CurrentPageName="@Localizer["Cooperation_BreadcrumbName"]" CurrentPagePath="@currentPagePath" />
        <script type="application/ld+json">
            @((MarkupString)CooperationOrganizationJsonLd)
        </script>
        <FaqPageJsonLd Faqs="@CooperationFaqs" />
        <SeoHreflangs />
        @if (isV3)
        {
            <link rel="stylesheet" href="/css/cooperation-tables-v3.css" />
        }
    </HeadContent>

    @if (isV3)
    {
        <div class="cooperation-container-v3">
            <CascadingValue Value="@OpenFormModalRequested">
                <CooperationLandingV3 />
            </CascadingValue>
        </div>
        <CoopFormModal @bind-IsOpen="_isFormModalOpen" />
    }
    else
    {
        <RentoomBookingWeb.Components.Pages.NotFoundPage />
    }
}

@code {
    [Parameter] public string? Version { get; set; }

    private bool _isFormModalOpen;

    private string CooperationOrganizationJsonLd => JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["@id"] = SiteBase.GetAbsoluteUrl("/#organization"),
        ["name"] = "Rentoom",
        ["legalName"] = "Rentoom Apartamenty sp. z o.o.",
        ["alternateName"] = "Rentoom Apartamenty",
        ["url"] = SiteBase.GetAbsoluteUrl("/"),
        ["logo"] = new Dictionary<string, object>
        {
            ["@type"] = "ImageObject",
            ["url"] = SiteBase.GetAbsoluteUrl("/assets/images/logo-nowe-Rentoom-final-158x112.png")
        },
        ["description"] = HomeLocalizer["Home_OrganizationDescription"].Value,
        ["email"] = "info@rentoom.pl",
        ["telephone"] = "+48 881 388 001",
        ["taxID"] = "8792727407",
        ["address"] = new Dictionary<string, object>
        {
            ["@type"] = "PostalAddress",
            ["streetAddress"] = "ul. Stanisława Szymańskiego 1B",
            ["postalCode"] = "87-100",
            ["addressLocality"] = "Toruń",
            ["addressCountry"] = "PL"
        },
        ["contactPoint"] = new Dictionary<string, object>
        {
            ["@type"] = "ContactPoint",
            ["contactType"] = "customer service",
            ["telephone"] = "+48 881 388 001",
            ["email"] = "info@rentoom.pl",
            ["availableLanguage"] = new[] { "pl", "en" }
        },
        ["sameAs"] = new[]
        {
            "https://www.facebook.com/RentoomApartamenty/",
            "https://www.instagram.com/rentoomapartamenty/"
        }
    }, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });

    private IReadOnlyList<FaqItemDto> CooperationFaqs => Enumerable.Range(1, 7)
        .Select(index => new FaqItemDto
        {
            Question = Localizer[$"Coop_Faq{index}_Q"].Value,
            Answer = (index == 1
                ? Localizer["Coop_V3_Faq1_A"]
                : Localizer[$"Coop_Faq{index}_A"]).Value
        })
        .ToArray();

    private EventCallback OpenFormModalRequested =>
        EventCallback.Factory.Create(this, () => _isFormModalOpen = true);
}
