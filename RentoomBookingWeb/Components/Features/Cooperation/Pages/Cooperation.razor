@using RentoomBookingWeb.Components.Features.Cooperation.Components;
@using RentoomBooking.SharedClasses.Services.Descriptions
@inject NavigationManager NavManager
@using Microsoft.Extensions.Localization;
@inject IStringLocalizer<RentoomBookingWeb.Cooperation> Localizer;
@inject RentoomBookingWeb.Services.Localization.IRouteLocalizationService RouteService

@{
    var normalizedVersion = Version?.Trim().ToLowerInvariant();
    var isV3 = string.IsNullOrEmpty(normalizedVersion) || normalizedVersion == "v3";
    var isNotFound = !isV3;
    var pageTitle = Localizer["Cooperation_PageTitle"];
    var metaDesc = Localizer["Cooperation_MetaDescription"];
    var ogTitle = Localizer["Cooperation_OgTitle"];
    var cooperationBasePath = RouteService.GetLocalizedUrl("Cooperation");
    var currentPagePath = cooperationBasePath;
}

@if (isNotFound)
{
    <RentoomBookingWeb.Components.Pages.NotFoundPage />
}
else
{
    <PageTitle>@pageTitle</PageTitle>

    <HeadContent>
        <meta name="robots" content="index, follow" />
        <meta name="description" content="@metaDesc" />
        <meta name="keywords" content="@Localizer["Cooperation_MetaKeywords"]" />
        <link rel="canonical" href="@($"{NavManager.BaseUri.TrimEnd('/')}{currentPagePath}")" />

        <meta property="og:title" content="@ogTitle" />
        <meta property="og:description" content="@metaDesc" />
        <meta property="og:image" content="@($"{NavManager.BaseUri}assets/images/header-bg-coop.jpeg")" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@($"{NavManager.BaseUri.TrimEnd('/')}{currentPagePath}")" />
        <BreadcrumbJsonLd CurrentPageName="@Localizer["Cooperation_BreadcrumbName"]" CurrentPagePath="@currentPagePath" />
        <FaqPageJsonLd Faqs="@CooperationFaqs" />
        <SeoHreflangs />
        @if (isV3)
        {
            <link rel="stylesheet" href="/css/cooperation-tables-v3.css" />
        }
    </HeadContent>

    @if (isV3)
    {
        <div class="cooperation-container-v3">
            <CascadingValue Value="@OpenFormModalRequested">
                <CooperationLandingV3 />
            </CascadingValue>
        </div>
        <CoopFormModal @bind-IsOpen="_isFormModalOpen" />
    }
    else
    {
        <RentoomBookingWeb.Components.Pages.NotFoundPage />
    }
}

@code {
    [Parameter] public string? Version { get; set; }

    private bool _isFormModalOpen;

    private IReadOnlyList<FaqItemDto> CooperationFaqs => Enumerable.Range(1, 7)
        .Select(index => new FaqItemDto
        {
            Question = Localizer[$"Coop_Faq{index}_Q"].Value,
            Answer = (index == 1
                ? Localizer["Coop_V3_Faq1_A"]
                : Localizer[$"Coop_Faq{index}_A"]).Value
        })
        .ToArray();

    private EventCallback OpenFormModalRequested =>
        EventCallback.Factory.Create(this, () => _isFormModalOpen = true);
}
