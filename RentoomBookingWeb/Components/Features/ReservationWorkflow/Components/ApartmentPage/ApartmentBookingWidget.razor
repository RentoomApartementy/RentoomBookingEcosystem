@namespace RentoomBookingWeb.Components.Features.ReservationWorkflow.Components.ApartmentPage
@using RentoomBooking.SharedClasses.Models.IdoBooking

<div class="abw">

    @* ---- Step 1: guests first ---- *@
    <div class="abw-guests">
        <div class="abw-section-title">@Localizer["CalendarGuestsTitle"]</div>

        <div class="abw-stepper-row">
            <span class="abw-stepper-label">@Localizer["CalendarAdults"]</span>
            <div class="abw-stepper-controls">
                <button type="button" class="abw-stepper-btn" @onclick="DecrementAdults" disabled="@(_adults <= MinAdults)" aria-label="−">−</button>
                <span class="abw-stepper-value">@_adults</span>
                <button type="button" class="abw-stepper-btn" @onclick="IncrementAdults" disabled="@(TotalGuests >= MaxGuests)" aria-label="+">+</button>
            </div>
        </div>

        <div class="abw-stepper-row">
            <span class="abw-stepper-label">@Localizer["CalendarChildren"]</span>
            <div class="abw-stepper-controls">
                <button type="button" class="abw-stepper-btn" @onclick="DecrementChildren" disabled="@(_children <= 0)" aria-label="−">−</button>
                <span class="abw-stepper-value">@_children</span>
                <button type="button" class="abw-stepper-btn" @onclick="IncrementChildren" disabled="@(TotalGuests >= MaxGuests)" aria-label="+">+</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_occupancyNotice))
        {
            <div class="abw-notice">@_occupancyNotice</div>
        }
    </div>

    @* ---- Price-from anchor ---- *@
    @if (_frozenFromPrice is decimal fromPrice)
    {
        <div class="abw-fromprice">@Localizer["CalendarFromPerNight", FormatPrice(fromPrice)]</div>
    }
    else if (_minPriceLoading)
    {
        <div class="abw-fromprice">
            <span class="mini-spinner"></span>
            <span>@Localizer["Loading"]</span>
        </div>
    }
    else if (_minPrice is decimal minPrice)
    {
        <div class="abw-fromprice">@Localizer["CalendarFromPerNight", FormatPrice(minPrice)]</div>
    }

    @* ---- Step 2: availability-aware calendar ---- *@
    <div class="abw-dates">
        <div class="abw-dates-prompt">@CheckInPrompt</div>

        <div class="abw-weekdays">
            @foreach (var wd in WeekdayHeaders())
            {
                <span class="abw-weekday">@wd</span>
            }
        </div>

        <div class="abw-months @(_loading ? "is-refreshing" : "")" @ref="_monthsRef">
            @foreach (var monthStart in MonthStarts())
            {
                <div class="abw-month">
                    <div class="abw-month-title">@MonthTitle(monthStart)</div>
                    <div class="abw-grid">
                        @for (var b = 0; b < LeadingBlanks(monthStart); b++)
                        {
                            <span class="abw-day abw-day-blank"></span>
                        }
                        @for (var d = 1; d <= DaysInMonth(monthStart); d++)
                        {
                            var date = new DateOnly(monthStart.Year, monthStart.Month, d);
                            var pastDisabled = date < _today;
                            var dataLoaded = _calendar is not null;
                            var selectableNow = dataLoaded && IsSelectableNow(date);
                            var isSelectedEnd = IsSelectedEnd(date);
                            var isSelectedEdge = IsSelectedStart(date) || isSelectedEnd;
                            var halfDay = dataLoaded && !pastDisabled && !isSelectedEdge && IsSingleNightGap(date);
                            var fullyBooked = dataLoaded && !pastDisabled && !halfDay && !selectableNow && !IsAvailable(date);
                            var loadingDay = !dataLoaded && !pastDisabled && !isSelectedEdge;
                            var classes = "abw-day"
                                + (selectableNow ? " abw-day-available" : "")
                                + (halfDay ? " abw-day-booked-bottom" : "")
                                + (fullyBooked ? " abw-day-booked" : "")
                                + (pastDisabled ? " abw-day-disabled" : "")
                                + (loadingDay ? " abw-day-loading" : "")
                                + (IsSelectedStart(date) ? " abw-day-start" : "")
                                + (isSelectedEnd ? " abw-day-end" : "")
                                + (IsInRange(date) ? " abw-day-inrange" : "");
                            <span class="abw-day-cell">
                                <button type="button"
                                        class="@classes"
                                        disabled="@(!selectableNow)"
                                        @onclick="@(() => OnDayClicked(date))">
                                    <span class="abw-day-num">@d</span>
                                    @if (fullyBooked)
                                    {
                                        <span class="abw-day-strike"></span>
                                    }
                                </button>
                                @if (isSelectedEnd)
                                {
                                    <button type="button"
                                            class="abw-day-clear"
                                            @onclick="ClearSelectionAsync"
                                            @onclick:stopPropagation="true"
                                            aria-label="@Localizer["CalendarClearSelection"]">×</button>
                                }
                            </span>
                        }
                    </div>
                </div>
            }
            @if (_loadingMoreMonths)
            {
                <div class="abw-loadmore-spinner">
                    <span class="mini-spinner"></span>
                    <span>@Localizer["CalendarLoadingMoreMonths"]</span>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_dateNotice))
        {
            <div class="abw-notice">@_dateNotice</div>
        }
    </div>

</div>
