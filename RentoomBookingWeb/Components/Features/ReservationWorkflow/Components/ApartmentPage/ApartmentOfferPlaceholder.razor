@using Microsoft.Extensions.Localization

<div class="placeholder-offer"
     role="button"
     tabindex="0"
     aria-label="@Localizer["PriceAvailableAfterSelectingDates"]"
     @onclick="OnSelectDates"
     @onkeydown="HandleKeyDown">
    <div class="placeholder-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M19 19H5V8h14m-3-7v2H8V1H6v2H5c-1.11 0-2 .89-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5h-1V1m-1 11h-5v5h5v-5z"/></svg>
    </div>
    <b class="placeholder-title">@Localizer["PriceAvailableAfterSelectingDates"]</b>
    <p class="placeholder-desc">@Localizer["Apartment_PriceSelectDatesDescription"]</p>
    <div class="summary-offer-price-button" @onclick:stopPropagation="true">
        <Button Type="ButtonType.Primary" Class="btn-select-dates" OnClick="HandleButtonClick">
            <svg aria-hidden="true" style="width: 18px; height: 18px;" viewBox="0 0 24 24"><path fill="currentColor" d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 002 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg>
            @Localizer["SelectDatesButtonLabel"]
        </Button>
    </div>
</div>

@code {
    [Parameter] public IStringLocalizer Localizer { get; set; } = default!;
    [Parameter] public EventCallback OnSelectDates { get; set; }

    private Task HandleButtonClick(MouseEventArgs _)
        => OnSelectDates.InvokeAsync();

    private Task HandleKeyDown(KeyboardEventArgs e)
        => e.Key is "Enter" or " " ? OnSelectDates.InvokeAsync() : Task.CompletedTask;
}
