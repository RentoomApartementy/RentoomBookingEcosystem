@using System.Globalization
@using System.Diagnostics
@using RentoomBooking.SharedClasses.Integrations.RentoomApp.Reviews
@using RentoomBooking.SharedClasses.Integrations.RentoomApp.Reviews.Models
@implements IDisposable
@inject IApartmentReviewReader ReviewReader
@inject Microsoft.Extensions.Localization.IStringLocalizer<RentoomBookingWeb.Apartment> Localizer
@inject ILogger<ApartmentReviewScoreBadge> Logger

@if (_isLoading)
{
    <span class="apartment-review-score apartment-review-score-loading"
          aria-hidden="true"></span>
}
else if (_aggregate?.AverageScore is not null)
{
    <span class="apartment-review-score"
          aria-label="@AccessibleLabel"
          title="@AccessibleLabel">
        <span aria-hidden="true">@FormattedScore</span>
    </span>
}

@code {
    [Parameter] public int? ApartmentItemId { get; set; }

    private ApartmentReviewAggregateDto? _aggregate;
    private CancellationTokenSource? _loadCancellation;
    private int? _loadedApartmentItemId;
    private bool _isLoading;
    private bool _loadStarted;
    private bool _disposed;

    private string FormattedScore => _aggregate is null
        ? string.Empty
        : ReviewPresentationFormatter.FormatAggregateScore(
            _aggregate,
            CultureInfo.CurrentUICulture);

    private string AccessibleLabel => _aggregate is null
        ? string.Empty
        : Localizer[
            "ApartmentReviewAverageLabel",
            FormattedScore,
            _aggregate.RatingScale.ToString(CultureInfo.CurrentUICulture)];

    protected override void OnParametersSet()
    {
        if (_loadStarted && _loadedApartmentItemId == ApartmentItemId)
        {
            return;
        }

        _loadedApartmentItemId = ApartmentItemId;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        _aggregate = null;
        _isLoading = true;
        _loadStarted = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loadStarted || _disposed)
        {
            return;
        }

        _loadStarted = true;
        await LoadAggregateAsync();
    }

    private async Task LoadAggregateAsync()
    {
        var stopwatch = Stopwatch.StartNew();
        var cancellationToken = _loadCancellation?.Token ?? CancellationToken.None;

        if (ApartmentItemId is not int apartmentItemId || apartmentItemId <= 0)
        {
            _isLoading = false;
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        try
        {
            _aggregate = await ReviewReader.GetApartmentReviewAggregateAsync(
                apartmentItemId,
                cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            _aggregate = null;
        }
        catch (Exception exception)
        {
            _aggregate = null;
            Logger.LogWarning(
                exception,
                "Failed to load aggregate review score for apartment item {ApartmentItemId}.",
                apartmentItemId);
        }
        finally
        {
            _isLoading = false;
            Logger.LogDebug(
                "ApartmentReviewScoreBadge timing ApartmentItemId {ApartmentItemId}: {ElapsedMilliseconds} ms",
                ApartmentItemId,
                stopwatch.ElapsedMilliseconds);
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
