@using System.Globalization
@using RentoomBooking.SharedClasses.Integrations.RentoomApp.Reviews
@using RentoomBooking.SharedClasses.Integrations.RentoomApp.Reviews.Models

<article class="option-container">
    <header class="review-card-head">
        <div class="review-rating">
            <span class="stars" aria-hidden="true">
                @for (var star = 0; star < 5; star++)
                {
                    <img src="assets/svgs/star.svg" alt="" width="16" height="16" />
                }
            </span>
            <span class="review-score">@Score</span>
        </div>

        <img class="booking-logo"
             src="https://upload.wikimedia.org/wikipedia/commons/e/e3/Booking.com_logo2.png"
             alt="Booking.com"
             loading="lazy"
             width="120"
             height="20" />
    </header>

    @if (ShowApartmentName && !string.IsNullOrWhiteSpace(Review.ApartmentName))
    {
        <p class="review-apartment">@Review.ApartmentName</p>
    }

    <blockquote class="option-content">
        @Review.PositiveText
    </blockquote>

    <footer class="review-author">
        <span class="review-avatar" aria-hidden="true">@AuthorInitial</span>
        <p>
            <strong>@AuthorName</strong>
            <small>@Metadata</small>
        </p>
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public ApartmentReviewCardDto Review { get; set; } = default!;
    [Parameter] public bool ShowApartmentName { get; set; } = true;

    private CultureInfo Culture => CultureInfo.CurrentUICulture;
    private string Score => ReviewPresentationFormatter.FormatScore(Review, Culture);
    private string AuthorName => ReviewPresentationFormatter.GetAuthorName(Review);
    private string AuthorInitial => ReviewPresentationFormatter.GetAuthorInitial(Review, Culture);
    private string Metadata => ReviewPresentationFormatter.BuildMetadata(Review, Culture);
}
