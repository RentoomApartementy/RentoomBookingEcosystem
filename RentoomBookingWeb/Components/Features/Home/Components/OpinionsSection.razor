@using System.Globalization
@using System.Diagnostics
@using RentoomBooking.SharedClasses.Integrations.RentoomApp.Reviews
@using RentoomBooking.SharedClasses.Integrations.RentoomApp.Reviews.Models
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IApartmentReviewReader ReviewReader
@inject IStringLocalizer<HomePage> Localizer
@inject ILogger<OpinionsSection> Logger

@if (_isLoading)
{
    <section class="opinions-section opinions-loading" aria-busy="true" aria-labelledby="@HeadingId">
        <h2 class="visually-hidden" id="@HeadingId">@SectionTitle</h2>
        <div class="opinions-loading-placeholder" aria-hidden="true"></div>
    </section>
}
else if (_reviews.Count > 0)
{
    <section class="opinions-section" aria-labelledby="@HeadingId">
        <h2 class="opinions-title" id="@HeadingId">
            @SectionTitle
        </h2>

        <div class="options-slider-wrapper">
            <SimpleCarousel EnableAutoScroll="false" ShowNavigation="@(_reviews.Count > 1)">
                @foreach (var review in _reviews)
                {
                    <Opinion Review="review" ShowApartmentName="ShowApartmentName" />
                }
            </SimpleCarousel>
        </div>
    </section>
}

@code {
    private IReadOnlyList<ApartmentReviewCardDto> _reviews = Array.Empty<ApartmentReviewCardDto>();
    private CancellationTokenSource? _loadCancellation;
    private bool _isLoading = true;
    private bool _loadStarted;
    private bool _disposed;
    private int? _lastApartmentItemId;
    private int _lastMaximumItems;
    private string? _lastLanguage;

    [Parameter] public int? ApartmentItemId { get; set; }
    [Parameter] public bool ShowApartmentName { get; set; } = true;
    [Parameter] public int MaximumItems { get; set; } = 12;
    [Parameter] public string? Title { get; set; }

    private string SectionTitle => string.IsNullOrWhiteSpace(Title)
        ? Localizer["opinionText"]
        : Title;

    private string HeadingId => ApartmentItemId is int id
        ? $"apartment-opinions-{id}"
        : "home-opinions";

    protected override void OnParametersSet()
    {
        var language = CultureInfo.CurrentUICulture.Name;
        if (_loadStarted &&
            _lastApartmentItemId == ApartmentItemId &&
            _lastMaximumItems == MaximumItems &&
            string.Equals(_lastLanguage, language, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _lastApartmentItemId = ApartmentItemId;
        _lastMaximumItems = MaximumItems;
        _lastLanguage = language;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        _reviews = Array.Empty<ApartmentReviewCardDto>();
        _isLoading = true;
        _loadStarted = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loadStarted || _disposed)
        {
            return;
        }

        _loadStarted = true;
        await LoadReviewsAsync();
    }

    private async Task LoadReviewsAsync()
    {
        var stopwatch = Stopwatch.StartNew();
        var language = CultureInfo.CurrentUICulture.Name;
        var cancellationToken = _loadCancellation?.Token ?? CancellationToken.None;

        try
        {
            _reviews = ApartmentItemId is int apartmentItemId
                ? await ReviewReader.GetApartmentReviewsAsync(
                    apartmentItemId,
                    language,
                    limit: MaximumItems,
                    cancellationToken: cancellationToken)
                : await ReviewReader.GetLatestReviewsPerApartmentAsync(
                    language,
                    cancellationToken: cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            _reviews = Array.Empty<ApartmentReviewCardDto>();
        }
        catch (Exception exception)
        {
            _reviews = Array.Empty<ApartmentReviewCardDto>();
            Logger.LogWarning(
                exception,
                "Failed to load public Booking.com reviews for apartment item {ApartmentItemId} and language {Language}.",
                ApartmentItemId,
                language);
        }
        finally
        {
            _isLoading = false;
            Logger.LogDebug(
                "OpinionsSection timing ApartmentItemId {ApartmentItemId}: {ElapsedMilliseconds} ms",
                ApartmentItemId,
                stopwatch.ElapsedMilliseconds);
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
